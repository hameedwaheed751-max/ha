# Copy to .env on the VPS only. Do not commit .env.
# Set this to the SHA-512 hex digest of a newly generated, high-entropy API key.
# Use the same new key as WAHA_GATEWAY_API_KEY; never use the previously exposed key.
WAHA_API_KEY_SHA512=
WAHA_GATEWAY_API_KEY=
FIREBASE_PROJECT_ID=
# The single existing WAHA session shared by active, approved Firebase agents.
WAHA_SESSION_NAME=
# Leave empty for native clients. Set exact trusted origins only for a browser client.
CORS_ALLOWED_ORIGINS=
